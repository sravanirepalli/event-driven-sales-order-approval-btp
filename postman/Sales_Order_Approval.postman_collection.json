{
  "info": {
    "_postman_id": "1407826a-e1d0-45de-beb8-362319ec096f",
    "name": "Sales Order Approval",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "55359094",
    "description": "End-to-end API validation for the Event-Driven Sales Order Approval solution on SAP BTP. Use the provided environment template and supply credentials only in your private Postman environment."
  },
  "item": [
    {
      "name": "01 - Get XSUAA Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\npm.environment.set(\"access_token\", response.access_token);",
              "// Professional validation checks",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
              "const json = pm.response.json();",
              "pm.test('Access token returned', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{xsuaa_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{xsuaa_client_secret}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            }
          ]
        },
        "url": "{{xsuaa_token_url}}/oauth/token",
        "description": "Obtains an OAuth 2.0 client-credentials token for secured CAP API calls."
      },
      "response": []
    },
    {
      "name": "01B - Get Integration Suite Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\npm.environment.set(\"cpi_access_token\", response.access_token);",
              "// Professional validation checks",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
              "const json = pm.response.json();",
              "pm.test('Access token returned', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              ""
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{cpi_client_id}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{cpi_client_secret}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            }
          ]
        },
        "url": "{{cpi_token_url}}/oauth/token",
        "description": "Obtains an OAuth 2.0 client-credentials token for the Integration Suite runtime endpoint."
      },
      "response": []
    },
    {
      "name": "02 - Evaluate Approval",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{cap_base_url}}/odata/v4/sales/EvaluateApproval",
        "description": "Evaluates the configured approval policy for the selected sales order. When returned, the event ID is stored for subsequent approval or rejection requests."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Professional validation checks",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
              "const json = pm.response.json();",
              "pm.test('Approval decision returned', () => pm.expect(json.approvalRequired).to.be.a('boolean'));",
              "if (json.eventId) pm.environment.set('approval_event_id', json.eventId);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Approve Request",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{approval_event_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{cap_base_url}}/odata/v4/sales/ApproveRequest",
        "description": "Submits an approval decision for the event identified by approval_event_id."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Professional validation checks",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Reject Request",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"eventId\": \"{{approval_event_id}}\",\n  \"reason\": \"{{rejection_reason}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{cap_base_url}}/odata/v4/sales/RejectRequest",
        "description": "Submits a rejection decision and reason for the event identified by approval_event_id."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Professional validation checks",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Trigger Approval iFlow",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{cpi_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"{{order_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{iflow_base_url}}/http/sales-order-approval-v2",
        "description": "Submits a sales-order request to Integration Suite and starts the end-to-end approval process."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Professional validation checks",
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "pm.test('Response time is below 10 seconds', () => pm.expect(pm.response.responseTime).to.be.below(10000));"
            ]
          }
        }
      ]
    }
  ]
