{
  "name": "sales-order-approval",
  "version": "1.0.0",
  "private": true,
  "description": "Event-driven sales order approval extension on SAP BTP",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9"
  },
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "integration": {
              "password": "integration",
              "roles": [
                "IntegrationClient"
              ]
            },
            "approver": {
              "password": "approver",
              "roles": [
                "ApprovalProcessor"
              ]
            },
            "auditor": {
              "password": "auditor",
              "roles": [
                "Auditor"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "IntegrationClient",
                "ApprovalProcessor",
                "Auditor",
                "Administrator"
              ]
            }
          }
        },
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  }
}
